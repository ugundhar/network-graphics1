{
    "_version": "1.12.0",
    "sap.app": {
        "id": "i2d.ps.networkgraph",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": {
            "version": "${project.version}"
        },
        "ach": "PS-FIO",
        "resources": "resources.json",
        "dataSources": {
            "mainService": {
                "uri": "/sap/opu/odata/sap/PS_NETWORK_GRAPH_SRV/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "annotation"
                    ],
                    "localUri": "localService/metadata.xml"
                }
            },
            "annotation": {
                "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='PS_NETWORK_GRAPH_ANNO_MDL',Version='0001')/$value",
                "type": "ODataAnnotation",
                "settings": {
                    "localUri": "localService/annotations.xml"
                }
            }
        },
        "sourceTemplate": {
            "id": "sap.ui.ui5-template-plugin.1worklist",
            "version": "1.71.20",
            "toolsId": "91077f1c-1732-47dd-bb79-e408d8896c66"
        },
        "crossNavigation": {
            "inbounds": {
                "ProjectNetworkGraph-display": {
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    },
                    "semanticObject": "ProjectNetworkGraph",
                    "action": "display"
                }
            },
            "outbounds": {
                "NetworkActivity-displayList": {
                    "semanticObject": "NetworkActivity",
                    "action": "displayList"
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [
            "F5130"
        ],
        "archeType": "transactional"
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://task",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": false,
            "phone": false
        },
        "fullWidth": true
    },
    "sap.ui5": {
        "flexEnabled": true,
        "rootView": {
            "viewName": "i2d.ps.networkgraph.view.App",
            "type": "XML",
            "async": true,
            "id": "app"
        },
        "dependencies": {
            "minUI5Version": "${sap.ui5.dist.version}",
            "libs": {
                "sap.f": {
                    "lazy": false
                },
                "sap.fe.navigation": {
                    "lazy": false
                },
                "sap.m": {
                    "lazy": false
                },
                "sap.suite.ui.commons": {
                    "lazy": false
                },
                "sap.ui.comp": {
                    "lazy": false
                },
                "sap.ui.core": {
                    "lazy": false
                },
                "sap.ui.layout": {
                    "lazy": false
                },
                "sap.ui.generic.app": {
                    "lazy": false
                },
                "sap.ushell": {
                    "lazy": false
                },
                "sap.fe.placeholder": {
                    "lazy": false
                }
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "i2d.ps.networkgraph.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "type": "sap.ui.model.odata.v2.ODataModel",
                "settings": {
                    "defaultCountMode": "Inline",
                    "headers": {
                        "sap-cancel-on-close": "true"
                    }
                }
            }
        },
        "services": {
            "ShellUIService": {
                "factoryName": "sap.ushell.ui5service.ShellUIService",
                "lazy": false,
                "settings": {
                    "setTitle": "auto"
                }
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "viewPath": "i2d.ps.networkgraph.view",
                "controlId": "idAppControl",
                "controlAggregation": "pages",
                "bypassed": {
                    "target": [
                        "notFound"
                    ]
                },
                "async": true
            },
            "routes": [
                {
                    "pattern": "",
                    "name": "network",
                    "target": "network"
                },
                {
                    "pattern": ":?sap-iapp-state:",
                    "name": "network",
                    "target": "network"
                }
            ],
            "targets": {
                "network": {
                    "viewName": "Network",
                    "viewId": "network",
                    "placeholder": {
                        "html": "sap/fe/placeholder/view/PlaceholderLR.fragment.html",
                        "autoClose": false
                    }
                },
                "notFound": {
                    "viewName": "NotFound",
                    "viewId": "notFound"
                }
            }
        }
    }
}