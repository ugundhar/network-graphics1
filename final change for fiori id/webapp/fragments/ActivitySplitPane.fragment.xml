<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f">
	<NavContainer id="activitySidePane"  width="100%">
		<f:DynamicPage id="activityPage">
			<f:title>
				<f:DynamicPageTitle id="dynamicPageTitle">
					<f:heading>
						<VBox id="titleVBox">
							<Title text="hello world"/>
						</VBox>
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>
			<f:header>
				<f:DynamicPageHeader>
					<Text text="Hello from the fragment-based DynamicPage!"/>
				</f:DynamicPageHeader>
			</f:header>
			<f:content>
				<VBox class="sapUiSmallMargin">
					<Text text="Maintenance Order: {activityModel>/MaintenanceOrder}"/>
					<Text text="Operation: {activityModel>/attributes/0/value}"/>
					<!-- etc. -->
				</VBox>
			</f:content>
		</f:DynamicPage>
	</NavContainer>
</core:FragmentDefinition>



