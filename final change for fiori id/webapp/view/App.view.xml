<mvc:View
	displayBlock="true"
	height="100%"
	xmlns="sap.f"
	xmlns:mvc="sap.ui.core.mvc">
	<FlexibleColumnLayout id="flexibleColumnLayout" backgroundDesign="Solid">
		<beginColumnPages>
			<mvc:XMLView id="beginView" viewName="com.odata.odata.view.View1"/>
		</beginColumnPages>
		<midColumnPages>
			<mvc:XMLView id="detailView" viewName="com.odata.odata.view.Detail"/>
		</midColumnPages>
		<endColumnPages>
			<mvc:XMLView id="lineDetailView" viewName="com.odata.odata.view.LineDetail"/>
		</endColumnPages>
	</FlexibleColumnLayout>
</mvc:View>