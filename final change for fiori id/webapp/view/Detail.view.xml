<mvc:View controllerName="com.odata.odata.controller.Detail" xmlns="sap.uxap" xmlns:m="sap.m" xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc">
	<ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="true" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false"
		headerContentPinnable="true" isChildPage="true" upperCaseAnchorBar="false">
		<headerTitle>
			<ObjectPageDynamicHeaderTitle navButtonPress="onNavBack">
				<expandedHeading>
					<m:Title text="Operation {selectedOperation>/MaintenanceOrderOperation}" wrapping="true"/>
				</expandedHeading>
				<snappedHeading>
					<m:Title text="Operation {selectedOperation>/MaintenanceOrderOperation}" wrapping="true"/>
				</snappedHeading>
				<actions>
					<m:Button text="Close" type="Transparent" press="onCloseDetailPress"/>
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Maintenance Order"/>
					<m:Text text="{selectedOperation>/MaintenanceOrder}" class="sapUiSmallMarginTop"/>
				</m:VBox>
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Operation Number"/>
					<m:Text text="{selectedOperation>/MaintenanceOrderOperation}" class="sapUiSmallMarginTop"/>
				</m:VBox>
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="Description"/>
					<m:Text text="{selectedOperation>/OperationDescription}" class="sapUiSmallMarginTop"/>
				</m:VBox>
			</m:FlexBox>
		</headerContent>
		<sections>
			<ObjectPageSection title="Network Activity">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<form:SimpleForm maxContainerCols="2" editable="false" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12" emptySpanL="0"
								emptySpanM="0" columnsL="1" columnsM="1">
								<form:content>
									<m:Label text="ControllingArea"/>
									<m:Text text="{selectedOperation>/ControllingArea}"/>
									<m:Label text="SystemStatusText"/>
									<m:Text text="{selectedOperation>/SystemStatusText}"/>
									<m:Label text="WorkCenter"/>
									<m:Text text="{selectedOperation>/WorkCenter}"/>
								</form:content>
							</form:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection title="General Information">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<form:SimpleForm maxContainerCols="2" editable="false" layout="ResponsiveGridLayout" labelSpanL="12" labelSpanM="12" emptySpanL="0"
								emptySpanM="0" columnsL="1" columnsM="1">
								<form:content>
									<m:Label text="ControllingArear"/>
									<m:Text text="{selectedOperation>/ControllingArea}"/>
									<m:Label text="SystemStatusText"/>
									<m:Text text="{selectedOperation>/SystemStatusText}"/>
									<m:Label text="WorkCenter"/>
									<m:Text text="{selectedOperation>/WorkCenter}"/>
									<m:Label text="OperationWorkCenterTypeCode"/>
									<m:Text text="{selectedOperation>/OperationWorkCenterTypeCode}"/>
									<m:Label text="Description"/>
									<m:Text text="{selectedOperation>/MaintOrderConfirmation}"/>
									<m:Label text="Operation"/>
									<m:Text text="{selectedOperation>/MaintenanceOrderRoutingNode}"/>
									<m:Label text="ActualWorkQuantity"/>
									<m:Text text="{selectedOperation>/ActualWorkQuantity}"/>
									<m:Label text="MaintOrderConfirmation"/>
									<m:Text text="{selectedOperation>/MaintOrderConfirmation}"/>
									<m:Label text="MaintenanceOrderRoutingNode"/>
									<m:Text text="{selectedOperation>/MaintenanceOrderRoutingNode}"/>
								</form:content>
							</form:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
	</ObjectPageLayout>
</mvc:View>
